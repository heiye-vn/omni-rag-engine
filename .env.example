# ==============================================================================
# omni-rag-engine 全模态 RAG 引擎配置文件模板
# 请复制本文件为 `.env` 并填写您的真实配置：
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 阿里百炼 (DashScope / 通义千问) 各种大模型配置 (强烈推荐，多模态与Embedding首选)
# 获取地址: https://dashscope.console.aliyun.com/
# ------------------------------------------------------------------------------
# 阿里百炼全局 API Key
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 通义千问多模态视觉大模型 (用于图片理解: qwen-vl-max / qwen-vl-plus)
DASHSCOPE_VISION_MODEL=qwen-vl-max
# 通义千问 Embedding 文本向量模型 (用于后续向量存储: text-embedding-v3)
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# ------------------------------------------------------------------------------
# 2. DeepSeek 大模型配置 (文本理解、智能切块与问答首选)
# 获取地址: https://platform.deepseek.com/
# ------------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ------------------------------------------------------------------------------
# 3. 本地 Ollama 视觉/文本大模型配置 (免 API Key，纯本地私有运行)
# 快速启动命令: ollama run llava 或 ollama run qwen2-vl
# ------------------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_VISION_MODEL=llava

# ------------------------------------------------------------------------------
# 4. 任务状态持久化 (Job Persistence)
# 依赖 sqlalchemy / psycopg 已在 pyproject 主依赖组，无需额外安装
# ------------------------------------------------------------------------------
# 任务存储后端: database (默认，关系型数据库持久化) | memory (进程内内存，重启即失)
# 本地若无 PostgreSQL：可改 JOB_STORE_BACKEND=memory，或改 DATABASE_URL 为 SQLite
#   SQLite: sqlite:///./data/omni_rag.db
JOB_STORE_BACKEND=database
# 数据库连接串 (PostgreSQL 生产推荐；本地也可改用 SQLite 免去外部服务)
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/omni_rag
# 严格模式: 1 = 数据库不可用时拒绝启动（推荐生产开启），0 = 回退内存并打印 ERROR 日志
JOB_STORE_STRICT=0
# 任务结果保留时长 (秒)，默认 1800 (30 分钟)，超时后由后台协程清理
JOB_RESULT_TTL=1800
# 解析线程池并发数：默认 4，调高需关注物理机内存（Docling/PaddleOCR 每路约 1-3 GB）
PARSE_WORKERS=4
# 异步任务 result 的对象存储配置
# OBJECT_STORE_BACKEND: local (默认本地文件系统) | minio (生产推荐 S3 兼容对象存储)
# 默认 OBJECT_STORE_ROOT ./data/objects 仅在 local 模式下生效
OBJECT_STORE_BACKEND=local
OBJECT_STORE_ROOT=./data/objects
# ------------------------------------------------------------------------------
# 5. MinIO 对象存储配置 (OBJECT_STORE_BACKEND=minio 时生效)
# ------------------------------------------------------------------------------
# MinIO 服务地址 (Docker 内默认 minio:9000；本地直跑用 localhost:9000)
MINIO_ENDPOINT=localhost:9000
# 访问凭据 (与 docker-compose 中 minio 服务的 MINIO_ROOT_USER/PASSWORD 保持一致)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# 存储桶名 (必须与 docker-compose 中 minio-init 创建的 bucket 一致)
MINIO_BUCKET=omni-rag-objects
# 是否启用 HTTPS (生产建议 1；本地默认 0)
MINIO_SECURE=0
# 对象存储严格模式: 1 = MinIO 不可用时拒绝启动（推荐生产），0 = 回退本地并打印 ERROR
OBJECT_STORE_STRICT=0

# ------------------------------------------------------------------------------
# 6. API Key 鉴权 (Auth)
# ------------------------------------------------------------------------------
# 鉴权总开关：1 = 强制要求 Authorization: Bearer <key> 才能访问 /api/v1/*；
# 0 = 完全放行（仅本地开发）。生产必须设 1。
AUTH_ENABLED=0
# 合法的 API Key 列表（逗号分隔）。AUTH_ENABLED=1 时必填，至少配置 1 个；
# 为空时所有带 key 的请求均返回 503（防止生产误配置裸奔）。
API_KEYS=

# ------------------------------------------------------------------------------
# 7. 限流 (Rate Limit)
# ------------------------------------------------------------------------------
# 默认限流速率（slowapi 语法）：60/minute | 100/hour | 5/second 等
RATE_LIMIT_DEFAULT=60/minute
# 上传端点单独限流（POST /parse /parse-and-chunk /ingest /jobs）：
# 解析是重资源操作，比常规 API 更紧
RATE_LIMIT_UPLOAD=10/hour
