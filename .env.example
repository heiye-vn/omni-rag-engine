# ==============================================================================
# omni-rag-engine 全模态 RAG 引擎配置文件模板
# 请复制本文件为 `.env` 并填写您的真实配置：
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 阿里百炼 (DashScope / 通义千问) 各种大模型配置 (强烈推荐，多模态与Embedding首选)
# 获取地址: https://dashscope.console.aliyun.com/
# ------------------------------------------------------------------------------
# 阿里百炼全局 API Key
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 通义千问多模态视觉大模型 (用于图片理解: qwen-vl-max / qwen-vl-plus)
DASHSCOPE_VISION_MODEL=qwen-vl-max
# 通义千问 Embedding 文本向量模型 (用于后续向量存储: text-embedding-v3)
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3

# ------------------------------------------------------------------------------
# 2. DeepSeek 大模型配置 (文本理解、智能切块与问答首选)
# 获取地址: https://platform.deepseek.com/
# ------------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ------------------------------------------------------------------------------
# 3. 本地 Ollama 视觉/文本大模型配置 (免 API Key，纯本地私有运行)
# 快速启动命令: ollama run llava 或 ollama run qwen2-vl
# ------------------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_VISION_MODEL=llava
